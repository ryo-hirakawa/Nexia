# Supabase の設定値。Supabase ダッシュボード → Project Settings → API からコピーする。
# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local は git に載らない）。

# プロジェクトの URL（例: https://abcdefgh.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon key（公開鍵。ブラウザに載ってよい）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（秘密の管理者キー。RLS を無視できる。サーバーとテストだけで使う。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# 隔離テスト専用。テストが作る2人のテストユーザーのパスワード（任意の12文字以上）
TEST_USER_PASSWORD=
